# App
ENVIRONMENT=development
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=info
SECRET_KEY=change-me-use-at-least-32-characters
DATA_DIR=./data
DATABASE_URL=sqlite:///data/regai.db

# WorkOS
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:8000/auth/callback
BOOTSTRAP_ADMIN_EMAILS=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=regai-mvp

# AI providers: at least one required
GROQ_API_KEY=
NVIDIA_API_KEY=
DEFAULT_LLM_PROVIDER=groq

# Uploads
MAX_UPLOAD_SIZE=52428800
UPLOAD_WARN_DISK_USAGE_PERCENT=80
